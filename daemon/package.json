{
  "name": "agentrunner",
  "type": "module",
  "version": "1.1.3",
  "private": true,
  "main": "dist/cli.js",
  "bin": {
    "agentrunner": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx --env-file-if-exists=../../.env ./src/cli.ts serve --if-paired",
    "cli": "tsx --env-file-if-exists=../../.env ./src/cli.ts",
    "build": "tsup",
    "standalone": "node scripts/build-standalone.mjs",
    "start": "node dist/cli.js",
    "lint": "eslint --cache .",
    "check-types": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@agentrunner/core": "workspace:*",
    "@agentrunner/protocol": "workspace:*",
    "picocolors": "^1.1.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "eslint": "^9.39.5",
    "tsup": "^8.5.1",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@11.1.2"
}
